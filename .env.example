# Hosted Supabase project rplpdnuyipccsckzvmyg (ap-south-1), linked with
# `supabase link --project-ref rplpdnuyipccsckzvmyg`. DATABASE_URL is the pooled
# connection (6543) the NestJS api uses at runtime; DIRECT_URL is the direct
# session connection (5432) Prisma migrations need. Put the database password in
# your own .env — never here.
DATABASE_URL=postgresql://postgres.rplpdnuyipccsckzvmyg:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.rplpdnuyipccsckzvmyg:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# NestJS api
PORT=3001

# Supabase Auth. The api verifies every request's access token against the key
# set this project publishes at <SUPABASE_URL>/auth/v1/.well-known/jwks.json, so
# this must be the project URL the browser signs in to as well.
SUPABASE_URL=https://rplpdnuyipccsckzvmyg.supabase.co

# Next.js web. Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle,
# which is fine for these two: the anon key is public by design and RLS denies
# every table read. The value below is the hosted project's own legacy anon key,
# the same one `supabase projects api-keys` prints.
NEXT_PUBLIC_SUPABASE_URL=https://rplpdnuyipccsckzvmyg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJwbHBkbnV5aXBjY3Nja3p2bXlnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQwODM0MzgsImV4cCI6MjEwOTY1OTQzOH0.kEd9YEQC5e46cliFwLkxWNxdPtM8BmCc9eQUx_C46WE

# Playwright e2e seed only. The service_role key is a SECRET that writes through
# RLS (PostgREST + GoTrue admin); keep the real value in your gitignored .env and
# never commit it. `supabase projects api-keys` prints it as the legacy
# service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# Where the web server reaches the api from, used after login to check the email.
API_URL=http://127.0.0.1:3001
