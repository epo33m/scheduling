# Supabase Postgres. DATABASE_URL is the pooled connection the NestJS api uses at
# runtime; DIRECT_URL is the direct connection Prisma migrations need.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/scheduling
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/scheduling

# NestJS api
PORT=3001
