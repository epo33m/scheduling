# Supabase Postgres. DATABASE_URL is the pooled connection the NestJS api uses at
# runtime; DIRECT_URL is the direct connection Prisma migrations need. The values
# below are the ones `supabase start` prints for the local stack.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# NestJS api
PORT=3001

# Supabase Auth. The api verifies every request's access token against the key
# set this project publishes at <SUPABASE_URL>/auth/v1/.well-known/jwks.json, so
# this must be the project URL the browser signs in to as well.
SUPABASE_URL=http://127.0.0.1:54421

# Next.js web. Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle,
# which is fine for these two: the anon key only reaches Supabase Auth, and RLS
# denies every table read. The value below is the local stack's public key, the
# same one `supabase status` prints on any machine. Use the hosted project's own
# values when deploying.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Where the web server reaches the api from, used after login to check the email.
API_URL=http://127.0.0.1:3001
