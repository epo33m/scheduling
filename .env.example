# Supabase Postgres. DATABASE_URL is the pooled connection the NestJS api uses at
# runtime; DIRECT_URL is the direct connection Prisma migrations need. The values
# below are the ones `supabase start` prints for the local stack.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# NestJS api
PORT=3001
