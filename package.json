{
  "name": "scheduling",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "web",
    "api",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:api": "turbo run test:api",
    "test:e2e": "bun run --cwd web test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:generate": "bun run --cwd api db:generate",
    "db:migrate": "bun run --cwd api db:migrate",
    "db:seed": "turbo run db:seed",
    "db:seed-manager": "bun run --cwd api db:seed-manager",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
